# ============================================================
#  .gitignore — Portail BCU UYI
#  RACINE DU PROJET
# ============================================================

# ── Variables d'environnement & secrets ─────────────────────
.env
.env.*
!.env.example
!.env.template
*.env
*.env.local
*.env.production
*.env.staging
*.env.docker.example

# ── Clés & certificats ──────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ── Bases de données locales ─────────────────────────────────
*.sqlite3
*.sqlite
*.db
*.db-shm
*.db-wal
db.sqlite3

# ── Logs ────────────────────────────────────────────────────
*.log
*.log.*
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python / Django ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.pyc
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
.installed.cfg
*.egg-link
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
nosetests.xml
.cache/

# Environnement virtuel Python
venv/
env/
ENV/
.venv/
.virtualenv/

# Django spécifique
staticfiles/
static_root/
mediafiles/
media_root/
/portail-backend/staticfiles/
/portail-backend/media/
/portail-backend/static_collected/

# ── Node.js / Frontend ───────────────────────────────────────
node_modules/
portail-frontend/node_modules/
portail-frontend/dist/
portail-frontend/build/
portail-frontend/.vite/
*.tsbuildinfo
.pnp
.pnp.js
.yarn/install-state.gz

# ── Docker ───────────────────────────────────────────────────
# Ne pas versionner les fichiers d'override secrets Docker
docker-compose.override.yml
docker-compose.prod.yml
docker-compose.secrets.yml

# ── IDE & Éditeurs ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.project
.classpath

# ── Coverage & tests ─────────────────────────────────────────
htmlcov/
.coverage
coverage/
*.cover

# ── Fichiers temporaires / systèmes ─────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig

# ── Fichiers sensibles divers ────────────────────────────────
*.secret
secrets.yml
secrets.json
credentials.json
service-account.json

# ── Backups Git (sauvegardes locales) ───────────────────────
.git.backup/
**/.git.backup/
