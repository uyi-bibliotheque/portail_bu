# .env.example - Template pour tous les environnements
# Copiez ce fichier vers .env.dev ou .env.prod

# Django
DEBUG=False
SECRET_KEY=change_this_in_production
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
USE_POSTGRES=True
DB_NAME=portail_bu
DB_USER=portail_user
DB_PASSWORD=change_this_in_production
DB_HOST=db
DB_PORT=5432

# Email
EMAIL_HOST=smtp.offilive.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=bcuy1-portail@offilive.com
EMAIL_HOST_PASSWORD=change_this_in_production

# Frontend
FRONTEND_URL=http://localhost:5173

# Sécurité (adapté selon environnement)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False