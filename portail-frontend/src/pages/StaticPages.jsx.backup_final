              maxWidth: 760, 
              fontSize: 'clamp(14px, 1vw, 15px)', 
              lineHeight: 1.8 
            }}>
              La Bibliothèque Centrale de l'Université de Yaoundé I a été réorganisée en quatre (04) Départements 
              pour mieux structurer les services documentaires et accompagner les usagers selon leurs besoins spécifiques.
            </p>
          </div>
        </div>
        <div className="container-sm" style={{ padding: 'clamp(32px, 5vw, 56px) 16px' }}>
          <div style={{ display: 'grid', gap: 'clamp(16px, 1.8vw, 24px)' }}>
            {departments.map((dept, index) => (
              <Reveal key={dept.title} className="reveal-up" delay={index * 80}>
                <DepartmentCardWithPhoto {...dept} />
              </Reveal>
            ))}
          </div>

          <Reveal className="reveal-up" delay={300}>
            <div style={{ 
              marginTop: 'clamp(32px, 4vw, 48px)',
              padding: 'clamp(24px, 3vw, 40px)',
              background: 'white',
              borderRadius: 'var(--radius)',
              border: '1px solid var(--border)',
              borderTop: '4px solid var(--or)',
              boxShadow: '0 4px 20px rgba(0,0,0,0.04)'
