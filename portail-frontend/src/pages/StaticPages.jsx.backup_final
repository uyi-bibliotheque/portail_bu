                <h3 style={{ fontWeight: 700, fontSize: 'clamp(16px, 1.1vw, 17px)', marginBottom: 10, color: 'var(--bleu-nuit)' }}>
                  {c.title}
                </h3>
                <p style={{ fontSize: 'clamp(13px, 0.9vw, 14px)', color: 'var(--texte-muted)', lineHeight: 1.7, marginBottom: 14 }}>
                  {c.desc}
