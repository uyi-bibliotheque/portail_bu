  return (
    <Layout>
      <Helmet>
        <title>Organisation de la Bibliothèque Centrale - BCU UYI</title>
        <meta name="description" content="Découvrez l'organisation de la Bibliothèque Centrale de l'Université de Yaoundé I : 4 départements, 15 sections et plus de 30 unités." />
      </Helmet>
      <style>{responsiveStyles}</style>
      <div style={{ 
        background: 'linear-gradient(135deg, var(--bleu-nuit) 0%, #2D2178 100%)', 
        padding: 'clamp(32px, 5vw, 48px) 0 clamp(24px, 3vw, 32px) 0' 
      }}>
        <div className="container">
          <Breadcrumb items={[
            { label: 'Accueil', href: '/' },
            { label: 'Organisation' }
          ]} />
          <h1 className="font-serif" style={{ 
            fontSize: 'clamp(28px, 4vw, 40px)', 
            color: 'white', 
            fontWeight: 400, 
            marginBottom: 8 
          }}>
            Organisation <span style={{ color: 'var(--or)' }}>de la BC-UYI</span>
          </h1>
          <p style={{ color: 'rgba(255,255,255,0.65)', fontSize: 'clamp(14px, 1vw, 15px)' }}>
            Découvrez les départements, sections et unités qui composent la Bibliothèque Centrale
          </p>
        </div>
      </div>
      <div className="container" style={{ padding: 'clamp(32px, 5vw, 56px) 16px' }}>
        <Reveal className="reveal-up">
          <div style={{
            display: 'grid',
            gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))',
            gap: 'clamp(16px, 1.8vw, 24px)',
            marginBottom: 'clamp(32px, 4vw, 48px)'
          }}>
            {departmentsData.map(dept => (
              <div key={dept.id} style={{
                padding: 'clamp(18px, 2vw, 24px)',
                background: 'white',
                border: '1px solid var(--border)',
                borderRadius: 'var(--radius-sm)',
                borderTop: `6px solid ${dept.color}`,
                textAlign: 'center',
                transition: 'all 0.3s ease',
                display: 'flex',
                flexDirection: 'column',
                alignItems: 'center',
                gap: 10,
                boxShadow: '0 2px 8px rgba(0,0,0,0.04)'
              }}
              onMouseEnter={e => {
                e.currentTarget.style.transform = 'translateY(-6px)';
                e.currentTarget.style.boxShadow = '0 12px 32px rgba(0,0,0,0.1)';
              }}
              onMouseLeave={e => {
                e.currentTarget.style.transform = '';
                e.currentTarget.style.boxShadow = '0 2px 8px rgba(0,0,0,0.04)';
              }}>
                <ResponsablePhoto 
                  src={dept.responsablePhoto} 
                  name={dept.responsable} 
                  size="clamp(70px, 8vw, 100px)" 
                />
                <div style={{ 
                  fontWeight: 700, 
                  fontSize: 'clamp(13px, 0.9vw, 15px)', 
                  color: 'var(--bleu-nuit)',
                  marginBottom: 2
                }}>
                  {dept.name}
                </div>
                <div style={{ 
                  fontSize: 'clamp(11px, 0.8vw, 12px)', 
                  color: 'var(--texte-muted)' 
                }}>
                  {dept.responsable}
                </div>
              </div>
            ))}
          </div>
        </Reveal>

        {departmentsData.map((dept, deptIndex) => (
          <Reveal key={dept.id} className="reveal-up" delay={deptIndex * 100}>
            <div style={{
              marginBottom: 'clamp(28px, 3.5vw, 40px)',
              background: 'white',
              borderRadius: 'var(--radius)',
              border: '1px solid var(--border)',
              overflow: 'hidden',
              boxShadow: '0 2px 12px rgba(0,0,0,0.04)'
            }}>
              <div style={{
                padding: 'clamp(18px, 2.2vw, 28px)',
                background: dept.color,
                color: 'white',
                display: 'flex',
                justifyContent: 'space-between',
                alignItems: 'center',
                flexWrap: 'wrap',
                gap: 12
              }}>
                <div style={{ display: 'flex', alignItems: 'center', gap: 'clamp(16px, 2vw, 24px)', flexWrap: 'wrap' }}>
                  <ResponsablePhoto 
                    src={dept.responsablePhoto} 
                    name={dept.responsable} 
                    size="clamp(60px, 7vw, 80px)" 
                  />
                  <div>
                    <h3 style={{ 
                      fontSize: 'clamp(18px, 1.4vw, 22px)', 
                      fontWeight: 700, 
                      marginBottom: 2
                    }}>
                      {dept.name}
                    </h3>
                    <div style={{ 
                      fontSize: 'clamp(12px, 0.85vw, 14px)', 
                      opacity: 0.85,
                      display: 'flex',
                      alignItems: 'center',
                      gap: 8
                    }}>
                      <User size={16} />
                      Responsable : {dept.responsable}
                    </div>
                  </div>
                </div>
                <span style={{
                  fontSize: 'clamp(11px, 0.8vw, 12px)',
                  background: 'rgba(255,255,255,0.2)',
                  padding: '6px 16px',
                  borderRadius: 50,
                  fontWeight: 600
                }}>
                  {dept.sections.length} sections
                </span>
              </div>
              <div style={{ padding: 'clamp(20px, 2.5vw, 32px)' }}>
                {dept.sections.map((section, secIndex) => (
                  <SectionCardWithPhoto
                    key={secIndex}
                    title={section.title}
                    responsable={section.responsable}
                    responsablePhoto={section.responsablePhoto}
                    units={section.units}
                    color={dept.color}
                  />
                ))}
              </div>
            </div>
          </Reveal>
        ))}

        <Reveal className="reveal-up" delay={400}>
          <div style={{
            padding: 'clamp(24px, 3vw, 36px)',
            background: 'linear-gradient(135deg, var(--bleu-nuit) 0%, #2D2178 100%)',
            borderRadius: 'var(--radius)',
            textAlign: 'center',
            color: 'white'
          }}>
            <div style={{
              display: 'grid',
              gridTemplateColumns: 'repeat(auto-fit, minmax(120px, 1fr))',
              gap: 'clamp(16px, 2vw, 24px)'
            }}>
              <div>
                <div style={{ fontSize: 'clamp(28px, 3vw, 36px)', fontWeight: 800, color: 'var(--or)' }}>
                  4
                </div>
                <div style={{ fontSize: 'clamp(12px, 0.85vw, 14px)', opacity: 0.8 }}>
                  Départements
                </div>
              </div>
              <div>
                <div style={{ fontSize: 'clamp(28px, 3vw, 36px)', fontWeight: 800, color: 'var(--or)' }}>
                  15
                </div>
                <div style={{ fontSize: 'clamp(12px, 0.85vw, 14px)', opacity: 0.8 }}>
                  Sections
                </div>
              </div>
              <div>
                <div style={{ fontSize: 'clamp(28px, 3vw, 36px)', fontWeight: 800, color: 'var(--or)' }}>
                  30+
                </div>
                <div style={{ fontSize: 'clamp(12px, 0.85vw, 14px)', opacity: 0.8 }}>
                  Unités
                </div>
              </div>
              <div>
                <div style={{ fontSize: 'clamp(28px, 3vw, 36px)', fontWeight: 800, color: 'var(--or)' }}>
                  45+
                </div>
                <div style={{ fontSize: 'clamp(12px, 0.85vw, 14px)', opacity: 0.8 }}>
                  Agents
                </div>
              </div>
            </div>
          </div>
        </Reveal>
      </div>
    </Layout>
  );
}
