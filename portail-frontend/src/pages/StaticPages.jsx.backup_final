        </Reveal>
        <div style={{ marginTop: 32, display: 'flex', gap: 'clamp(8px, 1vw, 12px)', flexWrap: 'wrap' }}>
          <Link to="/contact" className="btn btn-bleu" style={{ fontSize: 'clamp(13px, 0.9vw, 14px)', padding: 'clamp(9px, 1vw, 11px) clamp(16px, 2vw, 24px)' }}>
            Nous contacter
