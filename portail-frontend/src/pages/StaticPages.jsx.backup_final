          <h4 style={{ fontWeight: 700, fontSize: 'clamp(13px, 0.9vw, 14px)', color: 'var(--bleu-nuit)', marginBottom: 8 }}>
            📋 Charte de l'utilisateur du réseau
          </h4>
          <p style={{ fontSize: 'clamp(12px, 0.85vw, 13px)', color: 'var(--texte-muted)', lineHeight: 1.6 }}>
            Les membres de la communauté universitaire entendent réaffirmer leur souci de n'utiliser 
            les nouvelles techniques de l'information dans le respect des règles établies.
          </p>
        </div>
      </div>
    )
  },
  reliure: {
    title: 'Service reliure',
    icon: '📋',
    desc: 'Le service de reliure propose plusieurs types de reliures pour vos mémoires, thèses et documents.',
    details: [
      'Reliure thermique (couverture rigide)',
      'Reliure spirale plastique',
      'Reliure spirale métallique',
      'Reliure manuelle et dos carré collé',
      'Délai standard : 24 à 48h ouvrées',
    ],
    hours: '08h00 – 17h00 (Lun–Ven)',
    content: (
      <div style={{ marginTop: 20 }}>
        <h3 style={{ fontSize: 'clamp(18px, 1.5vw, 22px)', color: 'var(--bleu-nuit)', marginBottom: 12 }}>
          Atelier de reliure
        </h3>
        <p style={{ lineHeight: 1.7, color: 'var(--texte-muted)', fontSize: 'clamp(14px, 0.95vw, 15px)' }}>
          La section reliure est équipée d'un atelier en charge de protéger le livre, d'augmenter sa 
          stabilité et sa durée de vie.
        </p>
        <h4 style={{ fontWeight: 700, marginTop: 20, color: 'var(--bleu-nuit)', fontSize: 'clamp(15px, 1.1vw, 17px)' }}>
          Types de reliure
        </h4>
        <ul style={{ lineHeight: 1.7, paddingLeft: 20, color: 'var(--texte-muted)', fontSize: 'clamp(14px, 0.95vw, 15px)' }}>
          <li><strong>Reliure courante :</strong> travail sobre en toile, en carton ou en cuir</li>
          <li><strong>Reliure d'art :</strong> pour les particuliers, bibliophiles et collectionneurs</li>
        </ul>
      </div>
    )
  },
  mediation: {
    title: 'Médiation documentaire',
    icon: '🤝',
    desc: 'Le service de médiation aide les usagers à optimiser leur recherche documentaire.',
    details: [
      'Assistance à la recherche bibliographique',
      "Aide à l'utilisation du catalogue PMB",
      'Initiation aux bases de données en ligne',
      'Rédaction de bibliographies',
      'Rendez-vous individuels sur réservation',
    ],
    hours: '09h00 – 17h00 (Lun–Ven) — Sur rendez-vous',
    content: null
  },
  formation: {
    title: 'Formation documentaire',
    icon: '🎓',
    desc: "Formations collectives et individuelles à la maîtrise de l'information scientifique.",
    details: [
      'Formation L1-L2 : Introduction à la bibliothèque (2h)',
      'Formation Master : Méthodologie de la recherche (4h)',
      'Atelier : Rédiger une bibliographie normalisée',
      'Atelier : Utiliser Research4Life et les bases données',
      'Chaque jeudi à 14h00 — Salle B12',
    ],
    hours: 'Jeudi 14h00 (session libre) + sessions programmées',
    content: (
      <div style={{ marginTop: 20 }}>
        <h3 style={{ fontSize: 'clamp(18px, 1.5vw, 22px)', color: 'var(--bleu-nuit)', marginBottom: 12 }}>
          Produits documentaires
        </h3>
        <p style={{ lineHeight: 1.7, color: 'var(--texte-muted)', fontSize: 'clamp(14px, 0.95vw, 15px)' }}>
          La Bibliothèque Centrale élabore pour vous des produits documentaires pour répondre au mieux 
          à vos besoins d'information.
        </p>
        <h4 style={{ fontWeight: 700, marginTop: 20, color: 'var(--bleu-nuit)', fontSize: 'clamp(15px, 1.1vw, 17px)' }}>
          Produits proposés
        </h4>
        <ul style={{ lineHeight: 1.7, paddingLeft: 20, color: 'var(--texte-muted)', fontSize: 'clamp(14px, 0.95vw, 15px)' }}>
          <li><strong>Dossier documentaire :</strong> Ensemble de documents sur une question donnée</li>
          <li><strong>Bibliographie :</strong> Liste de notices bibliographiques classées</li>
          <li><strong>Bulletin d'information :</strong> Publication périodique sur les actualités</li>
          <li><strong>Synthèse documentaire :</strong> Condensation et reformulation d'informations</li>
        </ul>
      </div>
    )
  }
};

export function ServicesPage({ type = 'general' }) {
  const s = SERVICES_DATA[type] || SERVICES_DATA.consultation;

  if (type === 'general') {
    return (
      <>
        <Seo
          title="Nos services"
          path="/services"
          description="Découvrez les services de la Bibliothèque Centrale Universitaire de Yaoundé I : consultation, WiFi campus, reliure, médiation documentaire et formation."
          keywords="services bibliothèque UYI, consultation bibliothèque, wifi campus, reliure, médiation documentaire, formation documentaire"
          canonical="https://bcu-uyi.cm/services"
        />
        <Layout>
        <Helmet>
          <title>Nos Services - Bibliothèque Centrale UYI</title>
          <meta name="description" content="Découvrez tous les services de la Bibliothèque Centrale de l'Université de Yaoundé I : consultation, WiFi, reliure, médiation et formation documentaire." />
        </Helmet>
        <style>{responsiveStyles}</style>
        <div style={{ 
          background: 'linear-gradient(135deg, var(--bleu-nuit) 0%, #2D2178 100%)', 
          padding: 'clamp(32px, 5vw, 48px) 0 clamp(24px, 3vw, 32px) 0' 
        }}>
          <div className="container">
            <Breadcrumb items={[
              { label: 'Accueil', href: '/' },
              { label: 'Services' }
            ]} />
            <h1 className="font-serif" style={{ 
              fontSize: 'clamp(28px, 4vw, 40px)', 
              color: 'white', 
              fontWeight: 400 
            }}>
              Nos <span style={{ color: 'var(--or)' }}>Services</span>
            </h1>
            <p style={{ color: 'rgba(255,255,255,0.65)', fontSize: 'clamp(14px, 1vw, 15px)' }}>
              Découvrez l'ensemble des services proposés par la Bibliothèque Centrale
            </p>
          </div>
        </div>
        <div className="container" style={{ padding: 'clamp(32px, 5vw, 56px) 16px' }}>
          <div style={{
            display: 'grid',
            gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))',
            gap: 'clamp(16px, 2vw, 24px)'
          }}>
            {[
              { title: 'Espace consultation', icon: '📖', desc: 'Salles de lecture climatisées avec plus de 500 places assises', link: '/services/consultation' },
              { title: 'Accès WiFi Campus', icon: '📶', desc: 'WiFi haut débit 200 Mbps couvrant 100% des espaces', link: '/services/wifi' },
              { title: 'Service Reliure', icon: '📋', desc: 'Reliure thermique, spirale et dos carré collé', link: '/services/reliure' },
              { title: 'Médiation documentaire', icon: '🤝', desc: 'Assistance à la recherche bibliographique et aux bases de données', link: '/services/mediation' },
              { title: 'Formation documentaire', icon: '🎓', desc: 'Formations à la maîtrise de l\'information scientifique', link: '/services/formation' },
            ].map((service, index) => (
              <Reveal key={service.title} className="reveal-up" delay={index * 80}>
                <Link to={service.link} style={{
                  background: 'white',
                  border: '1px solid var(--border)',
                  borderRadius: 'var(--radius-sm)',
                  padding: 'clamp(20px, 2.5vw, 28px)',
                  textDecoration: 'none',
                  color: 'inherit',
                  display: 'block',
                  transition: 'all 0.3s ease',
                  textAlign: 'center'
                }}
                onMouseEnter={e => {
                  e.currentTarget.style.transform = 'translateY(-4px)';
                  e.currentTarget.style.boxShadow = 'var(--shadow-md)';
                  e.currentTarget.style.borderColor = 'var(--or)';
                }}
                onMouseLeave={e => {
                  e.currentTarget.style.transform = '';
                  e.currentTarget.style.boxShadow = '';
                  e.currentTarget.style.borderColor = 'var(--border)';
                }}>
                  <div style={{ fontSize: 'clamp(32px, 3.5vw, 40px)', marginBottom: 12 }}>{service.icon}</div>
                  <h3 style={{ fontWeight: 700, fontSize: 'clamp(15px, 1.1vw, 17px)', color: 'var(--bleu-nuit)', marginBottom: 8 }}>
                    {service.title}
                  </h3>
                  <p style={{ fontSize: 'clamp(13px, 0.9vw, 14px)', color: 'var(--texte-muted)', lineHeight: 1.6 }}>
                    {service.desc}
                  </p>
                  <div style={{ marginTop: 14, color: 'var(--or)', fontSize: 'clamp(12px, 0.8vw, 13px)', fontWeight: 600 }}>
                    En savoir plus →
                  </div>
                </Link>
              </Reveal>
            ))}
          </div>
        </div>
