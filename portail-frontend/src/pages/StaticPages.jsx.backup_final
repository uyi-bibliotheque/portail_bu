          borderTop: '1px dashed var(--border)'
        }}>
          {units.map((unit, idx) => (
            <div key={idx} style={{
              display: 'flex',
              alignItems: 'center',
              gap: 10,
              padding: '8px 14px',
              background: 'var(--beige)',
              borderRadius: 8,
              fontSize: 'clamp(12px, 0.85vw, 13px)',
              color: 'var(--texte-muted)',
              flexWrap: 'wrap'
            }}>
              <Layers size={14} color={color || 'var(--or)'} />
              <span><strong>{unit.name}</strong> — {unit.responsable}</span>
            </div>
          ))}
        </div>
      )}
