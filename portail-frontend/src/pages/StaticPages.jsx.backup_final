function SectionCardWithPhoto({ title, responsable, responsablePhoto, units, color, isResponsable = true }) {
  return (
    <div style={{
      background: 'white',
      border: '1px solid var(--border)',
      borderRadius: 'var(--radius-sm)',
      padding: 'clamp(20px, 2.5vw, 32px)',
      marginBottom: 16,
      transition: 'all 0.3s ease',
      boxShadow: '0 2px 8px rgba(0,0,0,0.04)'
    }}
    onMouseEnter={e => {
      e.currentTarget.style.boxShadow = '0 8px 30px rgba(0,0,0,0.08)';
      e.currentTarget.style.borderColor = color || 'var(--or)';
    }}
    onMouseLeave={e => {
      e.currentTarget.style.boxShadow = '0 2px 8px rgba(0,0,0,0.04)';
      e.currentTarget.style.borderColor = 'var(--border)';
    }}>
      <div style={{
        display: 'flex',
        alignItems: 'center',
        gap: 'clamp(16px, 2vw, 24px)',
        flexWrap: 'wrap',
        marginBottom: units && units.length > 0 ? 16 : 0
      }}>
        {isResponsable && responsablePhoto && (
          <ResponsablePhoto 
            src={responsablePhoto} 
            name={responsable} 
            size="clamp(70px, 8vw, 100px)" 
          />
        )}
        <div style={{ flex: 1, minWidth: '180px' }}>
          <h4 style={{ 
            fontWeight: 700, 
            fontSize: 'clamp(16px, 1.2vw, 18px)', 
            color: 'var(--bleu-nuit)',
            display: 'flex',
            alignItems: 'center',
            gap: 10,
            flexWrap: 'wrap'
          }}>
            <Users size={20} color={color || 'var(--or)'} />
            {title}
          </h4>
          <div style={{
            fontSize: 'clamp(14px, 0.95vw, 15px)',
            color: 'var(--texte-muted)',
            display: 'flex',
            alignItems: 'center',
            gap: 8,
            marginTop: 4
          }}>
            <User size={16} color={color || 'var(--or)'} />
            <strong>Responsable :</strong> {responsable}
          </div>
        </div>
      </div>
      {units && units.length > 0 && (
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))',
          gap: 10,
          marginTop: 16,
