export function RessourcesPage() {
  const DATABASES = [
    { name: 'Research4Life', logo: '🌐', desc: 'Accès aux plus grandes revues scientifiques mondiales pour les pays en développement.', href: 'https://www.research4life.org', categories: ['Médecine', 'Agriculture', 'Droit', 'Business'], color: '#059669' },
    { name: 'OpenDOAR', logo: '📂', desc: 'Répertoire mondial des archives institutionnelles en accès ouvert.', href: 'https://v2.sherpa.ac.uk/opendoar/', categories: ['Open Access'], color: '#6366f1' },
    { name: 'DOAJ', logo: '📰', desc: 'Répertoire de revues en accès libre avec contrôle qualité éditorial.', href: 'https://doaj.org', categories: ['Pluridisciplinaire'], color: '#1B1464' },
    { name: 'OpenEdition', logo: '📚', desc: 'Portail de ressources numériques en sciences humaines et sociales.', href: 'https://www.openedition.org', categories: ['SHS', 'Lettres'], color: '#8b5cf6' },
    { name: 'Gallica (BNF)', logo: '🗺️', desc: 'Bibliothèque numérique de la Bibliothèque nationale de France.', href: 'https://gallica.bnf.fr', categories: ['Patrimoine', 'Archives'], color: '#7C3AED' },
    { name: 'HAL Open Archives', logo: '📖', desc: 'Archive ouverte pluridisciplinaire pour le dépôt et la diffusion d\'articles scientifiques.', href: 'https://hal.archives-ouvertes.fr', categories: ['Recherche', 'Open Access'], color: '#10B981' },
  ];

  return (
    <Layout>
      <Helmet>
        <title>Ressources électroniques - Bibliothèque Centrale UYI</title>
        <meta name="description" content="Accédez aux bases de données et ressources en ligne disponibles pour la communauté de l'Université de Yaoundé I : Research4Life, OpenEdition, Gallica et plus." />
      </Helmet>
      <style>{responsiveStyles}</style>
      <div style={{ 
        background: 'linear-gradient(135deg, var(--bleu-nuit) 0%, #2D2178 100%)', 
        padding: 'clamp(32px, 5vw, 48px) 0 clamp(24px, 3vw, 32px) 0' 
      }}>
        <div className="container">
          <Breadcrumb items={[
            { label: 'Accueil', href: '/' },
            { label: 'Ressources électroniques' }
          ]} />
          <h1 className="font-serif" style={{ 
            fontSize: 'clamp(28px, 4vw, 40px)', 
            color: 'white', 
            fontWeight: 400, 
            marginBottom: 8 
          }}>
            Ressources <span style={{ color: 'var(--or)' }}>électroniques</span>
          </h1>
          <p style={{ color: 'rgba(255,255,255,0.65)', fontSize: 'clamp(14px, 1vw, 15px)' }}>
            Accès aux bases de données et ressources en ligne disponibles pour la communauté UYI
          </p>
        </div>
      </div>
      <div className="container" style={{ padding: 'clamp(32px, 5vw, 56px) 16px' }}>
        <div style={{ 
          display: 'grid', 
          gridTemplateColumns: 'repeat(auto-fill, minmax(280px, 1fr))', 
          gap: 'clamp(16px, 2vw, 24px)' 
        }}>
          {DATABASES.map((db, index) => (
            <Reveal key={db.name} className="reveal-up" delay={index * 50}>
              <a href={db.href} target="_blank" rel="noopener noreferrer" className="card" style={{
                display: 'flex',
                flexDirection: 'column',
                padding: 'clamp(16px, 2vw, 28px)',
                transition: 'all 0.3s ease',
                textDecoration: 'none',
                color: 'inherit',
                borderTop: `4px solid ${db.color || 'var(--or)'}`
              }}
              onMouseEnter={e => {
                e.currentTarget.style.transform = 'translateY(-4px)';
                e.currentTarget.style.boxShadow = 'var(--shadow-lg)';
              }}
              onMouseLeave={e => {
                e.currentTarget.style.transform = '';
                e.currentTarget.style.boxShadow = '';
              }}>
                <div style={{ fontSize: 'clamp(36px, 4vw, 48px)', marginBottom: 12 }}>{db.logo}</div>
                <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 6, flexWrap: 'wrap' }}>
                  <h3 style={{ fontWeight: 700, fontSize: 'clamp(15px, 1.1vw, 17px)', color: 'var(--bleu-nuit)' }}>{db.name}</h3>
                  <ExternalLink size={14} color="var(--texte-muted)" />
                </div>
                <p style={{ fontSize: 'clamp(13px, 0.9vw, 14px)', color: 'var(--texte-muted)', lineHeight: 1.7, flex: 1, marginBottom: 14 }}>
                  {db.desc}
                </p>
                <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
                  {db.categories.map(c => (
                    <span key={c} className="badge badge-blue" style={{ fontSize: 'clamp(9px, 0.7vw, 10px)' }}>{c}</span>
                  ))}
                </div>
              </a>
            </Reveal>
          ))}
        </div>
        <Reveal className="reveal-up" delay={300}>
          <div style={{ 
            marginTop: 'clamp(40px, 5vw, 60px)', 
            padding: 'clamp(24px, 3vw, 32px)', 
            background: 'white', 
            borderRadius: 'var(--radius)', 
            border: '1px solid var(--border)' 
          }}>
            <h3 style={{ 
              fontSize: 'clamp(18px, 1.8vw, 22px)', 
              color: 'var(--bleu-nuit)', 
              marginBottom: 16, 
              display: 'flex', 
              alignItems: 'center', 
              gap: 10 
            }}>
              <Globe size={24} color="var(--or)" />
              Accès aux ressources
            </h3>
            <p style={{ lineHeight: 1.7, color: 'var(--texte-muted)', fontSize: 'clamp(14px, 0.95vw, 15px)' }}>
              Pour accéder à ces ressources, vous devez être connecté au réseau de l'Université ou utiliser 
              vos identifiants SIGB. Les bases de données sont accessibles depuis le catalogue PMB ou directement 
              via les liens fournis.
            </p>
            <div style={{ marginTop: 16, display: 'flex', gap: 'clamp(8px, 1vw, 12px)', flexWrap: 'wrap' }}>
              <Link to="/catalogue" className="btn btn-bleu btn-sm" style={{ fontSize: 'clamp(13px, 0.9vw, 14px)' }}>
                <Search size={16} /> Accéder au catalogue
              </Link>
              <Link to="/contact" className="btn btn-ghost btn-sm" style={{ fontSize: 'clamp(13px, 0.9vw, 14px)' }}>
                <Mail size={16} /> Aide et assistance
              </Link>
            </div>
          </div>
        </Reveal>
      </div>
    </Layout>
  );
}

