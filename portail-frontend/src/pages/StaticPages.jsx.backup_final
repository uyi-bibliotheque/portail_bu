                <ResponsablePhoto 
                  src={imgMarieJoseEssi} 
                  name="Pr Marie-José Essi" 
                  size="clamp(90px, 12vw, 140px)" 
                />
                <div>
                  <div style={{ 
                    fontSize: 'clamp(11px, 0.8vw, 12px)', 
                    fontWeight: 700, 
                    textTransform: 'uppercase', 
                    color: 'var(--or)', 
