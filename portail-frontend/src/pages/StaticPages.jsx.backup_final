export function NotFoundPage() {
  return (
    <Layout>
      <Helmet>
        <title>Page non trouvée - Bibliothèque Centrale UYI</title>
        <meta name="description" content="La page que vous recherchez n'existe pas ou a été déplacée." />
      </Helmet>
      <style>{responsiveStyles}</style>
      <div style={{ textAlign: 'center', padding: 'clamp(60px, 10vw, 120px) 16px' }}>
        <div style={{ fontSize: 'clamp(48px, 8vw, 80px)', marginBottom: 24 }}>📭</div>
        <h1 style={{ fontSize: 'clamp(24px, 3vw, 32px)', fontWeight: 800, marginBottom: 12, color: 'var(--bleu-nuit)' }}>
          Page introuvable
        </h1>
        <p style={{ color: 'var(--texte-muted)', marginBottom: 32, fontSize: 'clamp(14px, 1vw, 16px)' }}>
          La page que vous recherchez n'existe pas ou a été déplacée.
        </p>
        <Link to="/" className="btn btn-bleu btn-lg" style={{
          padding: 'clamp(12px, 1.5vw, 14px) clamp(24px, 3vw, 32px)',
          fontSize: 'clamp(14px, 1vw, 16px)'
        }}>
          ← Retour à l'accueil
        </Link>
      </div>
    </Layout>
  );
}